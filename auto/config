#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --debian-installer none \
  --iso-application "CollingOS" \
  --iso-publisher "Colling Studio" \
  --iso-volume "CollingOS" \
  --bootappend-live "boot=live components quiet splash username=colling hostname=collingos locales=en_US.UTF-8" \
  --firmware-chroot true \
  --apt-recommends false \
  --security true \
  --updates true \
  "${@}"
